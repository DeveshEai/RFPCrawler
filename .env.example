# Example environment configuration — copy to `.env` and fill in your keys
APP_NAME="RFP Intelligence System"
VERSION="1.0.0"
DATABASE_URL="sqlite:///./rfp_intelligence.db"
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL="qwen/qwen3.8-27b"
SERPAPI_KEY="your_serpapi_key_here"
LLM_PROVIDER="groq"
GEMINI_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=rfp-alerts@eaisystems.com
MATCH_SCORE_THRESHOLD=70
HIGH_PRIORITY_SCORE=85
